--- !u!114 &1135294519
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1135294517}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: db826707753fd5f48ba78aadb3cdac55, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HowToPlayManager
  titleText: {fileID: 1632486254}
  descriptionText: {fileID: 1815920675}
  pageImage: {fileID: 1399751351}
  pageNumberText: {fileID: 2055469821}
  previousButton: {fileID: 60284175}
  nextButton: {fileID: 965150798}
  pages:
  - title: Welcome to Ghost In The Street
    description: 'The street is haunted and the ghosts are coming for you.


      Your
      goal is simple: stay alive for as long as you can. The longer you survive,
      the more enemies appear.'
    image: {fileID: 21300000, guid: 47a7d58c0c6e00e4a94f4ec7fb822f05, type: 3}
  - title: Movement
    description: 'Use W A S D or the Arrow Keys to move.


      Keep moving! Standing
      still lets enemies surround you.'
    image: {fileID: 21300000, guid: 18d47cdbc26c4894f9b360d6fba70554, type: 3}
  - title: Aiming
    description: 'Move the mouse to aim. Your shooting weapon fires toward the crosshair.


      You
      do not need to click. All weapons attack automatically.'
    image: {fileID: 21300000, guid: 54d14171d3a843f4eb318cb879941d58, type: 3}
  - title: Weapons
    description: 'You start with one random weapon.


      - Shooting weapon: fires
      projectiles toward the mouse.

      - Spinning weapon: orbits around you and
      hits nearby enemies.

      - Area weapon: damages every enemy inside its area.'
    image: {fileID: 21300000, guid: 63111854ae49f4648a6e17ec68a4c8c2, type: 3}
  - title: Enemies
    description: 'Touching an enemy hurts you.


      - Pocong : weak, but comes
      in large groups.

      - Banas : slow and tough.

      - Kunti : fast and
      dangerous.

      - Wewe : huge health. Keep your distance!'
    image: {fileID: 21300000, guid: 57a6e3c0678bda04b87270c09a9e9e79, type: 3}
  - title: Experience and Level Up
    description: 'Defeat enemies to gain experience (EXP).


      When the EXP bar
      is full you level up and the game pauses. Choose one upgrade: a new weapon
      or a stronger version of a weapon you already have, Increase HP or Movement
      Speed.'
    image: {fileID: 21300000, guid: 94f3f9935ed688e41be84503e4d6af6d, type: 3}
  - title: Health
    description: 'The health bar shows how much damage you can still take.


      After
      getting hit you are safe for a moment. When your health reaches zero, the game
      is over.'
    image: {fileID: 21300000, guid: 0c839dc8f4db08946ba22567314188d8, type: 3}
  - title: Pause
    description: 'Press Esc or P to pause the game.


      From the pause menu you
      can resume, restart, and go back to the main menu.'
    image: {fileID: 21300000, guid: b001faf57acc1694e8eb13dfd3e7eca9, type: 3}
  - title: Score
    description: 'Every run is saved: your survival time and how many enemies of
      each type you defeated.


      Open Score from the main menu to see your best
      time and your history.'
    image: {fileID: 21300000, guid: 1f654cc6a3551e14589a2309843a8b77, type: 3}
  - title: Tips
    description: '- Always keep moving and never get trapped in a corner.

      -
      Pick up new weapons early, then upgrade your favorites.

      - When a boss
      appears, aim at it while running around it.


      Good luck, and survives!'
    image: {fileID: 21300000, guid: 47a7d58c0c6e00e4a94f4ec7fb822f05, type: 3}
